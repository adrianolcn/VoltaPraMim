<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<article class="item-card">
    <div class="item-card-top">
        <%@ include file="status-item.jspf" %>
    </div>
    <h3><a href="<c:url value='/itens/${item.id}' />"><c:out value="${item.titulo}" /></a></h3>
    <p class="muted item-card-meta"><c:out value="${item.local.rotulo}" /> · <c:out value="${item.categoria.rotulo}" /></p>
    <p class="item-reference">Referência <strong><c:out value="${item.referenciaPublica}" /></strong></p>
</article>
