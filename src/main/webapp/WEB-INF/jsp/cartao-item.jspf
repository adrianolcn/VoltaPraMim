<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<article class="item-card">
    <div class="item-card-top">
        <c:choose>
            <c:when test="${item.estadoRotulo eq 'Disponível para retirada'}">
                <span class="badge badge-available">
                    <c:out value="${item.estadoRotulo}" />
                </span>
            </c:when>

            <c:when test="${item.estadoRotulo eq 'Devolvido'}">
                <span class="badge badge-returned">
                    <c:out value="${item.estadoRotulo}" />
                </span>
            </c:when>

            <c:otherwise>
                <span class="badge badge-pending">
                    <c:out value="${item.estadoRotulo}" />
                </span>
            </c:otherwise>
        </c:choose>
        <span class="item-category"><c:out value="${item.categoria.rotulo}" /></span>
    </div>
    <h3><a href="<c:url value='/itens/${item.id}' />"><c:out value="${item.titulo}" /></a></h3>
    <p class="muted"><c:out value="${item.local.rotulo}" /></p>
    <p class="item-reference">Referência <strong><c:out value="${item.referenciaPublica}" /></strong></p>
</article>
